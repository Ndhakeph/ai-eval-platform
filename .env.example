# --- Live judge (optional) ---------------------------------------------------
# The app builds and runs with NO environment variables set: the dashboard and
# all baked sample data render fully offline. These keys only enable the LIVE
# judge on the Score / Compare / Batch pages.

# FastRouter API key — OpenAI-compatible. Get one at https://fastrouter.ai
FASTROUTER_API_KEY=your_fastrouter_api_key_here

# Model the judge uses (any OpenAI-compatible model id FastRouter supports).
LLM_MODEL=anthropic/claude-sonnet-4.6
